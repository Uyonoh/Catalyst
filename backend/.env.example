# Supabase configuration for JWT verification
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed CORS origins (Next.js app URL)
# Default: http://localhost:3000  |  Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# LLM Provider Keys
# Multiple keys can be specified with suffix e.g., GEMINI_API_KEY_1, GEMINI_API_KEY_2
GEMINI_API_KEY_1=
GROQ_API_KEY_1=
OPENROUTER_API_KEY_1=
HF_TOKEN_1=
