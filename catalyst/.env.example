# ===========================================
# NEXT_PUBLIC Variables (exposed to client)
# These are embedded in the client-side bundle
# ===========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack Configuration (for billing)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ===========================================
# Server-Side Variables (only on server)
# These are only available in server components and API routes
# ===========================================

# Supabase Service Role Key (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=

# Google GenAI Configuration
GOOGLE_GENAI_API_KEY=

# Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# JWT Secret for session management
JWT_SECRET=

# Encryption Key for sensitive data
ENCRYPTION_KEY=

# Database URL for direct connections (if needed)
DATABASE_URL=

# ===========================================
# Optional Configuration
# ===========================================

# Node environment (development, production, test)
NODE_ENV=development

# Port for development server
PORT=3000

# Debug mode
DEBUG=catalyst:*

# ===========================================
# Feature Flags
# ===========================================

# Enable experimental features
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===========================================
# Third-party Service Keys
# ===========================================

# Optional: Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===========================================
# Notes:
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to git
# 3. For production, set these in your hosting provider's environment
# FastAPI backend URL (used by Next.js to proxy LLM calls)
BACKEND_URL=http://localhost:8000

